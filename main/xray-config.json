{
  "log": {"loglevel": "warning"},
  "inbounds": [{
    "port": 39443,
    "protocol": "vless",
    "settings": {
      "clients": [{"id": "<EXIT_UUID>", "flow": ""}],
      "decryption": "none"
    },
    "streamSettings": {
      "network": "tcp",
      "security": "reality",
      "realitySettings": {
        "show": false,
        "dest": "flexchat.top:443",
        "xver": 0,
        "serverNames": ["flexchat.top"],
        "privateKey": "<EXIT_PRIVATE_KEY>",
        "shortIds": ["<EXIT_SHORT_ID>"]
      }
    },
    "sniffing": {"enabled": true, "destOverride": ["http", "tls"]}
  }],
  "outbounds": [
    {"protocol": "freedom", "tag": "direct", "settings": {"domainStrategy": "UseIPv4"}},
    {"protocol": "blackhole", "tag": "blocked"}
  ],
  "routing": {
    "rules": [
      {"type": "field", "ip": ["<MAIN_IP>"], "outboundTag": "direct"}
    ]
  }
}
