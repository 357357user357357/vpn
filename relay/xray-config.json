{
  "log": {"loglevel": "warning"},
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {"id": "<PHONE_UUID>", "flow": ""}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "<CAMO_RELAY_DOMAIN>:443",
          "xver": 0,
          "serverNames": ["<CAMO_RELAY_DOMAIN>"],
          "privateKey": "<RELAY_PRIVATE_KEY>",
          "minClient": "",
          "maxClient": "",
          "maxTimedDiff": 0,
          "shortIds": ["<PHONE_SHORT_ID>"]
        }
      },
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"]}
    }
  ],
  "outbounds": [
    {
      "tag": "to-main",
      "protocol": "socks",
      "settings": {
        "servers": [{"address": "127.0.0.1", "port": 10809}]
      }
    },
    {"protocol": "freedom", "tag": "direct"},
    {"protocol": "blackhole", "tag": "blocked"}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {"type": "field", "domain": ["domain:openrouter.ai"], "outboundTag": "to-main"},
      {"type": "field", "ip": ["<RELAY_IP>"], "outboundTag": "direct"},
      {"type": "field", "domain": ["geosite:category-ru"], "outboundTag": "direct"},
      {"type": "field", "ip": ["geoip:ru", "geoip:private"], "outboundTag": "direct"}
    ]
  }
}
